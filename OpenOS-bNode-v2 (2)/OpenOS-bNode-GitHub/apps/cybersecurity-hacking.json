  "features": [
    "Metasploit Framework",
    "Network scanning (Nmap, Masscan)",
    "Packet analysis (Wireshark, Tcpdump)",
    "Wireless hacking (Aircrack-ng)",
    "Password cracking (Hashcat, John, Hydra)",
    "SQL injection (SQLMap)",
    "Web scanning (Nikto, Burp Suite, OWASP ZAP)",
    "Subdomain enumeration (Amass, Subfinder)",
    "OSINT tools (TheHarvester, Recon-ng, Maltego)",
    "Reverse engineering (Ghidra, Radare2, Binwalk)",
    "Binary analysis (GDB, Objdump, Strings)",
    "Exploit development (Pwntools, Scapy)",
    "Windows exploitation (Evil-WinRM, CrackMapExec)",
    "Memory forensics (Volatility)",
    "Digital forensics (Autopsy, Sleuthkit)",
    "Data recovery (Foremost, PhotoRec, TestDisk)",
    "Steganography (Steghide, Stegsolve)",
    "Cryptography tools (OpenSSL, GPG)",
    "SSH tools (SSH-keygen, SSH-keyscan, SSHPass)",
    "Fuzzing (Wfuzz, FFuf)",
    "Directory brute-forcing (Gobuster, Dirb, DirBuster)",
    "Enumeration (Enum4linux, SMBMap)",
    "Brute forcing (Medusa, Ncrack, Patator, Hydra)",
    "Hash identification (HashID)",
    "Data analysis (Awk, Sed, Grep, Cut, Sort)"
  ],
  "dependencies": [],
  "permissions": [
    "network",
    "raw-sockets",
    "system-admin",
    "storage"
  ],
  "config": {
    "autoUpdate": true,
    "logging": true,
    "database": true,
    "modules": true
  },
  "disclaimer": "For authorized security testing only. Unauthorized access is illegal."
}
