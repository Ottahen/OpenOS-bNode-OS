{
  "app": "Development Tools Suite",
  "description": "Complete development environment",
  "version": "latest",
  "category": "development",
  "preinstall": true,
  "autostart": false,
  "installation": {
    "method": "apt",
    "packages": [
      "git",
      "curl",
      "wget",
      "vim",
      "nano",
      "emacs",
      "neovim",
      "tmux",
      "htop",
      "btop",
      "gcc",
      "g++",
      "make",
      "cmake",
      "gdb",
      "valgrind",
      "strace",
      "docker",
      "docker-compose",
      "kubernetes",
      "kubectl",
      "terraform",
      "ansible",
      "vagrant",
      "virtualbox",
      "qemu",
      "libvirt",
      "jenkins",
      "gitlab-runner"
    ]
  },
  "features": [
    "Version control (Git)",
    "Text editors (Vim, Nano, Emacs, Neovim)",
    "Terminal multiplexer (Tmux)",
    "System monitoring (Htop, Btop)",
    "C/C++ compilation",
    "Build systems (Make, CMake)",
    "Debugging (GDB, Valgrind)",
    "System tracing (Strace)",
    "Containerization (Docker)",
    "Container orchestration (Kubernetes)",
    "Infrastructure as code (Terraform, Ansible)",
    "Virtual machines (Vagrant, VirtualBox, QEMU)",
    "CI/CD (Jenkins, GitLab Runner)",
    "Package management"
  ],
  "dependencies": [],
  "permissions": ["storage", "network", "system-admin"],
  "config": {
    "autoUpdate": true,
    "defaultEditor": "vim"
  }
}
