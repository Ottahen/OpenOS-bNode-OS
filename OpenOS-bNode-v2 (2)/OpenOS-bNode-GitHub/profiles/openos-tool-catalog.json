    },
    "defensive_endpoint": {
      "type": "apt",
      "tools": ["apparmor", "apparmor-utils", "apparmor-profiles", "auditd", "audispd-plugins", "aide", "aide-common", "lynis", "clamav", "clamav-daemon", "clamav-freshclam", "rkhunter", "chkrootkit", "debsums", "debsig-verify", "debsecan", "apt-listbugs", "needrestart", "unattended-upgrades", "fail2ban", "crowdsec", "crowdsec-firewall-bouncer-iptables", "libpam-pwquality", "libpam-google-authenticator", "pam-tmpdir", "tlog", "fapolicyd", "openSCAP", "scap-security-guide", "kernel-hardening-checker", "checksecurity", "tripwire", "samhain", "osquery", "wazuh-agent", "yubikey-manager", "pcscd", "pcsc-tools", "gnupg", "age", "sops", "pass", "keepassxc", "wireguard-tools", "openvpn", "tor", "torsocks", "proxychains4"]
    },
    "network_diagnostics": {
      "type": "apt",
      "tools": ["iproute2", "iputils-ping", "traceroute", "mtr-tiny", "dnsutils", "bind9-dnsutils", "whois", "nmap", "masscan", "tcpdump", "tshark", "wireshark", "netcat-openbsd", "socat", "iperf3", "ethtool", "arp-scan", "macchanger", "net-tools", "bridge-utils", "vlan", "wireguard-tools", "openvpn", "sshuttle", "autossh", "termshark", "speedtest-cli", "geoip-bin"]
    },
    "defensive_network": {
      "type": "apt",
      "tools": ["suricata", "snort", "zeek", "zeekctl", "nfdump", "ntopng", "zmap", "p0f", "netdiscover", "yara", "yara-doc", "yara-python", "clamav", "bro", "arkime", "wazuh-agent", "osquery", "filebeat", "auditbeat", "packetbeat", "elastic-agent", "crowdsec", "fail2ban", "nftables", "ufw", "firewalld", "iptables", "ipset", "conntrack", "tshark", "tcpdump"]
    },
    "forensics_and_ir": {
      "type": "apt-or-pipx",
      "tools": ["autopsy", "sleuthkit", "testdisk", "foremost", "scalpel", "dc3dd", "guymager", "ewf-tools", "afflib-tools", "libimage-exiftool-perl", "exiv2", "binwalk", "bulk-extractor", "hashdeep", "ssdeep", "hashid", "yara", "volatility3", "plaso", "timesketch", "log2timeline", "dislocker", "chntpw", "libewf", "memdump", "gdb", "radare2", "ghidra", "hexdump", "xxd", "strings", "file", "pdfinfo", "qpdf", "oletools", "exiftool"]
    },
    "devsecops": {
      "type": "apt-or-pipx-or-container",
      "tools": ["bandit", "pip-audit", "semgrep", "checkov", "safety", "gitleaks", "trivy", "syft", "grype", "osv-scanner", "hadolint", "shellcheck", "yamllint", "ansible-lint", "kube-bench", "kube-hunter", "kubesec", "k9s", "kubectl", "helm", "kustomize", "terraform", "opentofu", "packer", "vault", "consul", "nomad", "opa", "conftest", "cosign", "sigstore", "slsa-verifier", "git-secrets", "pre-commit", "trufflehog", "dependency-check", "zap", "nuclei"]
    },
    "security_lab_authorized": {
      "type": "apt-or-container",
      "tools": ["metasploit-framework", "zaproxy", "burpsuite", "sqlmap", "nikto", "ffuf", "wfuzz", "gobuster", "dirb", "feroxbuster", "whatweb", "wapiti", "nuclei", "httpx-toolkit", "amass", "subfinder", "theharvester", "recon-ng", "maltego", "spiderfoot", "shodan", "searchsploit", "exploitdb", "hydra", "medusa", "ncrack", "john", "hashcat", "hashcat-utils", "cewl", "crunch", "wordlists", "aircrack-ng", "hcxdumptool", "hcxtools", "wifite", "reaver", "bully", "kismet", "bettercap", "responder", "impacket-scripts", "enum4linux-ng", "smbclient", "smbmap", "crackmapexec", "evil-winrm", "kerbrute", "bloodhound", "bloodhound-python", "scapy", "pwntools", "boofuzz", "radamsa", "afl++", "gdb", "radare2", "ghidra"]
    }
  },
  "governance": {
    "safe_default": "lite",
    "services_default": "disabled",
    "external_sources": "Must be installed from a signed upstream repository or a pinned container image after an administrator review.",
    "authorized_use": "Active assessment and exploitation-oriented tools must be used only on systems, applications, and networks for which explicit authorization exists."
  }
}
